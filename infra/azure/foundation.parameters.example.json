{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "prefix": { "value": "gridcast" },
    "databasePassword": {
      "reference": {
        "keyVault": { "id": "<bootstrap-key-vault-resource-id>" },
        "secretName": "gridcast-database-password"
      }
    },
    "proxyToken": {
      "reference": {
        "keyVault": { "id": "<bootstrap-key-vault-resource-id>" },
        "secretName": "gridcast-proxy-token"
      }
    },
    "entraClientSecret": {
      "reference": {
        "keyVault": { "id": "<bootstrap-key-vault-resource-id>" },
        "secretName": "gridcast-entra-client-secret"
      }
    },
    "budgetContactEmails": { "value": ["<operator-email>"] },
    "budgetStartDate": { "value": "<first-day-of-current-month-in-UTC>" }
  }
}
