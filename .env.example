# Use a long random URL-safe password (letters, digits, hyphens or underscores).
POSTGRES_PASSWORD=
# Optional: generate a Fernet key for encrypted F1 account setup in Settings.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key separate from database backups; losing it requires re-entering the account.
CREDENTIALS_ENCRYPTION_KEY=
# Alternatively, provide an F1 account through the server environment.
F1_USERNAME=
F1_PASSWORD=
# Optional: an approved public Python package mirror if direct PyPI is unavailable.
# PIP_INDEX_URL=https://pypi.org/simple

# Local OTel traces, metrics and logs; CPU profiling runs inside Linux containers.
OTEL_ENABLED=true
OTEL_TRACE_SAMPLE_RATIO=1.0
PYROSCOPE_ENABLED=true

# Optional USD per allocated compute hour, including GPU if applicable.
# Unset means cost is unavailable, not zero. Estimates cover active model operations only.
ML_COMPUTE_HOURLY_USD=

# Local Compose intentionally has no sign-in. Never expose it publicly.
# ACA templates set HOSTED_MODE=true and read PROXY_AUTH_TOKEN from Key Vault.
# The hosted web must sit behind ACA Entra authentication; headers alone are not auth.
# JOB_MAX_RUNTIME_SECONDS=3600
# JOB_HEARTBEAT_SECONDS=15
